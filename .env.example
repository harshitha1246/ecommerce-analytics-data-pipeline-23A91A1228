# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce_db
DB_USER=admin
DB_PASSWORD=password

# Schemas
STAGING_SCHEMA=staging
PRODUCTION_SCHEMA=production
WAREHOUSE_SCHEMA=warehouse

# Data Generation
NUM_CUSTOMERS=1000
NUM_PRODUCTS=500
NUM_TRANSACTIONS=10000
TRANSACTION_DATE_RANGE_DAYS=365

# Pipeline Configuration
BATCH_SIZE=1000
MAX_RETRIES=3
LOGGING_LEVEL=INFO
TIMEZONE=UTC

# Data Paths
RAW_DATA_PATH=./data/raw
STAGING_DATA_PATH=./data/staging
PROCESSED_DATA_PATH=./data/processed

# Logging
LOG_DIRECTORY=./logs
LOG_LEVEL=INFO

# Docker
DOCKER_REGISTRY=
DOCKER_IMAGE_NAME=ecommerce-pipeline
DOCKER_IMAGE_TAG=latest

# Scheduling
SCHEDULE_TIME=02:00
SCHEDULE_TIMEZONE=UTC
